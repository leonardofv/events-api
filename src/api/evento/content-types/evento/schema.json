{
  "kind": "collectionType",
  "collectionName": "eventos",
  "info": {
    "singularName": "evento",
    "pluralName": "eventos",
    "displayName": "Evento"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "maxLength": 120,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "descricao": {
      "type": "blocks",
      "required": true
    },
    "dataInicio": {
      "type": "datetime",
      "required": true
    },
    "dataFim": {
      "type": "datetime",
      "required": false
    },
    "vagas": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria",
      "inversedBy": "eventos"
    },
    "local": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::local.local",
      "inversedBy": "eventos"
    },
    "palestrantes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::palestrante.palestrante",
      "inversedBy": "eventos"
    },
    "inscricoes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inscricao.inscricao",
      "mappedBy": "evento"
    }
  }
}
