{
  "kind": "collectionType",
  "collectionName": "categorias",
  "info": {
    "singularName": "categoria",
    "pluralName": "categorias",
    "displayName": "Categoria"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "maxLength": 60,
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nome",
      "required": true
    },
    "eventos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evento.evento",
      "mappedBy": "categoria"
    }
  }
}
